generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoomStatus {
  WAITING
  STARTING
  PLAYING
  FINISHED
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownedRooms   Room[]        @relation("RoomOwner")
  roomPlayers  RoomPlayer[]
  matchPlayers MatchPlayer[]
}

model Game {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  minPlayers  Int
  maxPlayers  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  rooms       Room[]
  matches     Match[]

  @@index([isActive, createdAt])
}

model Room {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  gameId       String
  ownerId      String?
  status       RoomStatus   @default(WAITING)
  maxPlayers   Int
  isPrivate    Boolean      @default(false)
  passwordHash String?
  settings     Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  game         Game         @relation(fields: [gameId], references: [id])
  owner        User?        @relation("RoomOwner", fields: [ownerId], references: [id])
  players      RoomPlayer[]
  matches      Match[]

  @@index([gameId, status])
  @@index([ownerId])
}

model RoomPlayer {
  id          String   @id @default(cuid())
  roomId      String
  userId      String?
  guestId     String?
  nickname    String
  isReady     Boolean  @default(false)
  isAlive     Boolean  @default(true)
  isConnected Boolean  @default(true)
  joinedAt    DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@unique([roomId, guestId])
  @@index([roomId])
  @@index([userId])
}

model Match {
  id         String        @id @default(cuid())
  roomId     String
  gameId     String
  winner     String?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  roundCount Int           @default(0)
  room       Room          @relation(fields: [roomId], references: [id])
  game       Game          @relation(fields: [gameId], references: [id])
  players    MatchPlayer[]
  votes      Vote[]

  @@index([roomId])
  @@index([gameId])
}

model MatchPlayer {
  id               String  @id @default(cuid())
  matchId          String
  userId           String?
  nickname         String
  role             String
  survived         Boolean
  eliminationRound Int?
  match            Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user             User?   @relation(fields: [userId], references: [id])

  @@index([matchId])
  @@index([userId])
}

model Vote {
  id          String   @id @default(cuid())
  matchId     String
  roundNumber Int
  voterId     String
  targetId    String
  voteType    String
  createdAt   DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, roundNumber, voterId, voteType])
  @@index([matchId, roundNumber])
}
